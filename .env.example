# Puerto único del servidor (páginas + WebSocket + SSE)
PORT=3000

# Catálogo externo (DummyJSON por defecto). Se usa como base: ${CATALOG_URL}/${id}
CATALOG_URL=https://dummyjson.com/products

# Tiempo máximo de espera por producto, en milisegundos (AbortController)
CATALOG_TIMEOUT_MS=5000

# Simular catálogo lento: se agrega ?delay=<valor> a cada consulta.
# 0 = sin delay. Ejemplo: 3000 = cada producto tarda ~3s en responder.
CATALOG_DELAY_MS=0
